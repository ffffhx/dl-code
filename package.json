{
  "name": "dl-code",
  "version": "0.1.0",
  "description": "A minimalist yet sufficient project for enabling everyone to learn how to develop an AI Coding Agent.",
  "main": "dist/main.js",
  "type": "module",
  "bin": {
    "dl-code": "./bin/dl-code.mjs"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "skills:preview": "tsx scripts/skills-preview.ts",
    "eval:prompts": "tsx --test tests/prompts.test.ts tests/prompt-eval.test.ts",
    "eval:prompts:live": "tsx scripts/prompt-eval.ts",
    "typecheck:prompts": "tsc -p tsconfig.prompts.json",
    "subagents:preview": "tsx scripts/subagents-preview.ts",
    "dev": "bun src/main.ts",
    "dev:silent": "bun src/main.ts",
    "build": "tsc",
    "start": "bun dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepare": "husky",
    "test:ui": "bun tests/opentui.integration.ts"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "langchain",
    "langgraph",
    "cli"
  ],
  "author": "Henry Li <henry1943@163.com>",
  "license": "MIT",
  "dependencies": {
    "@langchain/anthropic": "^1.3.20",
    "@langchain/community": "^1.1.19",
    "@langchain/core": "^1.1.29",
    "@langchain/langgraph": "^1.1.5",
    "@langchain/openai": "^1.2.10",
    "@opentui/core": "0.5.11",
    "ajv": "^8.18.0",
    "bun": "1.4.2",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "js-tiktoken": "^1.0.21",
    "langchain": "^1.2.28",
    "minimatch": "^10.0.1",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "yaml": "^2.7.0",
    "yargs": "^18.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.27",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "globals": "^17.1.0",
    "husky": "^9.1.7",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.54.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
